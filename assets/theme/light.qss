/* Light Theme */
QMainWindow, QDialog {
    background-color: #f5f5f5;
}

QWidget {
    background-color: #f5f5f5;
    color: #000000;
}

QGroupBox {
    border: 2px solid #cccccc;
    border-radius: 6px;
    margin-top: 1ex;
    font-weight: bold;
    padding-top: 10px;
}

QGroupBox::title {
    left: 10px;
    padding: 0 5px 0 5px;
}

QPushButton {
    background-color: #0d6efd;
    color: white;
    border: none;
    padding: 8px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #0b5ed7;
}

QPushButton:disabled {
    background-color: #cccccc;
    color: #666666;
}

QComboBox {
    padding: 8px;
    background-color: white;
    border: 1px solid #cccccc;
    border-radius: 4px;
}

QComboBox:hover {
    border-color: #0d6efd;
}

QTextEdit, QPlainTextEdit {
    background-color: white;
    color: #000000;
    font-family: 'Consolas', 'Monaco', monospace;
    border: 1px solid #cccccc;
    border-radius: 4px;
}

QProgressBar {
    border: 1px solid #cccccc;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #0d6efd;
    border-radius: 4px;
}

QLabel#statusLabel {
    color: #666666;
}

QLabel#recentLabel {
    color: #28a745;
}

QMenuBar {
    background-color: #f5f5f5;
    color: #000000;
}

QMenuBar::item {
    background-color: transparent;
    color: #000000 !important;
}

QMenuBar::item:selected {
    background-color: #0d6efd;
    color: white !important;
}

QMenu {
    background-color: white;
    color: #000000 !important;
    border: 1px solid #cccccc;
}

QMenu::item {
    background-color: transparent;
    color: #000000 !important;
    padding: 4px 20px;
}

QMenu::item:selected {
    background-color: #0d6efd;
    color: white !important;
}

QPushButton#convertBtn {
    background-color: #28a745;
    color: white;
    padding: 10px 20px;
}

QPushButton#convertBtn:hover {
    background-color: #218838;
}

QPushButton#convertBtn:disabled {
    background-color: #6c757d;
    color: #e0e0e0;
}

QTabWidget::pane {
    border: 1px solid #cccccc;
    background-color: white;
}

QTabBar {
    color: #000000 !important;
}

QTabBar::tab {
    background-color: #e0e0e0;
    color: #000000 !important;
    padding: 8px 16px;
    border: 1px solid #cccccc;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: white;
    color: #0078d4 !important;
    font-weight: bold;
}

QTabBar::tab:hover {
    background-color: #f0f0f0;
}

/* Tree widget and sidebar styling for Table of Contents */
QTreeWidget, QTreeView {
    background-color: #fcfcfc;
    color: #24292f !important;
    border: 1px solid #e1e4e8;
    border-radius: 4px;
}

QTreeView::item {
    color: #24292f !important;
    padding: 6px 4px;
}

QTreeView::item:hover {
    background-color: #f6f8fa;
}

QTreeView::item:selected {
    background-color: #0366d6;
    color: white !important;
}

/* Toolbar and button separators styling */
QToolBar {
    background-color: #f6f8fa;
    border-bottom: 1px solid #e1e4e8;
    padding: 4px;
    spacing: 8px;
}

QToolBar::separator {
    background-color: #e1e4e8;
    width: 1px;
    margin: 4px 6px;
}

QToolBar QWidget {
    background-color: transparent;
}
